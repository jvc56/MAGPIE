// Resources linked into magpie.exe and magpie_test.exe: the application
// manifest, the icon, and the version shown in the file's properties. The
// Makefile defines MAGPIE_VERSION_TEXT (0.1.3, unquoted: quotes do not survive
// the resource compiler's command line) and MAGPIE_VERSION_COMMAS (0,1,3,0)
// from MAGPIE_VERSION in src/impl/config.c.
#include <winver.h>

#define MAGPIE_QUOTE(text) #text
#define MAGPIE_STRING(text) MAGPIE_QUOTE(text)
#define MAGPIE_VERSION_STRING MAGPIE_STRING(MAGPIE_VERSION_TEXT)

1 24 "magpie.manifest"
1 ICON "magpie.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MAGPIE_VERSION_COMMAS
PRODUCTVERSION MAGPIE_VERSION_COMMAS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "MAGPIE"
      VALUE "FileDescription", "MAGPIE crossword game engine"
      VALUE "FileVersion", MAGPIE_VERSION_STRING
      VALUE "InternalName", "magpie"
      VALUE "LegalCopyright", "See LICENSE.md"
      VALUE "OriginalFilename", "magpie.exe"
      VALUE "ProductName", "MAGPIE"
      VALUE "ProductVersion", MAGPIE_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
