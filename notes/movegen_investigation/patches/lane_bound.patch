+  fprintf(stderr, "LB measured gens %llu lanes %llu best_lanes %llu\n", lb_measured_gens, lb_lanes_total, lb_best_lanes);
+  const char *vn[4] = {"V1 exact+rack", "V2 envelope", "V3 V1+RIT", "V5 groups+RIT"};
+  fprintf(stderr, "LB V5 groups per lane %.1f overflow %llu combine cost %.1f%% of shadow ticks\n",
+          (double)lb_groups_total / lb_groups_lanes, lb_groups_overflow, 100.0 * lb_v5_combine_ticks / instr_total);
+  for (int v = 0; v < 4; v++) {
+    fprintf(stderr, "LB %s: skips %.1f%% of all shadow ticks, %.1f%% of unexpanded-lane ticks, %.1f%% of lanes; violations %llu; cost %.1f%% of shadow ticks\n",
+      vn[v], 100.0 * lb_skip_ticks[v] / instr_total, 100.0 * lb_skip_unexp_ticks[v] / instr_unexpanded,
+      100.0 * lb_lanes_skipped[v] / lb_lanes_total, lb_violations[v], 100.0 * (v < 2 ? lb_cost_ticks[v] : 0) / instr_total);
+  }
+  fprintf(stderr, "LB V2 per-gen combine cost %.1f%% of shadow ticks (env build excluded)\n", 100.0 * lb_cost_ticks[2] / instr_total);
+  for (int b = 0; b < 8; b++) {
+    fprintf(stderr, "GAP %-6s %.1f%% of unexpanded lane ticks\n", names[b], 100.0 * instr_gap_ticks[b] / instr_unexpanded);
+  }
+  fprintf(stderr, "INSTR gens %llu shadow_ticks %llu unexpanded_lane_ticks %llu (%.1f%%) lanes %llu unexpanded %llu (%.1f%%)\n",
+          instr_gens, instr_total, instr_unexpanded, 100.0 * instr_unexpanded / instr_total,
+          instr_lanes, instr_lanes_unexp, 100.0 * instr_lanes_unexp / instr_lanes);
+}
