+#include <mach/mach_time.h>
+
+// ---- lane bound prototype (instrumentation) ----
+typedef struct LBPlacement {
+  int k, through_count;
+  uint32_t through_letters;
+  Equity fixed;            // W*through + sum cross_score*wm (+ nothing else)
+  uint16_t e[RACK_SIZE];   // sorted desc effective multipliers
+} LBPlacement;
+typedef void (*LBVisit)(void *ctx, const LBPlacement *pl);
+
+static void lb_eval_span(const MoveGen *gen, int k, int through_count,
+                         uint32_t through_letters, Equity through_score, int W, Equity cross_const,
+                         const uint8_t *lm, const uint8_t *wm, const uint8_t *cr,
+                         LBVisit visit, void *ctx) {
+  LBPlacement pl;
+  pl.k = k; pl.through_count = through_count; pl.through_letters = through_letters;
+  pl.fixed = W * through_score + cross_const;
+  for (int i = 0; i < RACK_SIZE; i++) pl.e[i] = 0;
+  for (int i = 0; i < k; i++) {
+    uint16_t v = (uint16_t)(W * lm[i] + lm[i] * wm[i] * cr[i]);
+    int j = i;
+    while (j > 0 && pl.e[j - 1] < v) { pl.e[j] = pl.e[j - 1]; j--; }
+    pl.e[j] = v;
+  }
+  (void)gen;
+  visit(ctx, &pl);
+}
+
+// Enumerates every placement in the lane. blocked_mask: empty squares that
+// cannot take a tile.
+static void lb_enumerate(const MoveGen *gen, const Square *sq, int max_tiles,
+                         uint32_t blocked_mask, LBVisit visit, void *ctx) {
+  for (int start = 0; start < BOARD_DIM; start++) {
+    if (start > 0 && square_get_letter(&sq[start - 1]) != ALPHABET_EMPTY_SQUARE_MARKER) continue;
+    int k = 0, through_count = 0, W = 1, any_cross = 0;
+    Equity through_score = 0, cross_const = 0;
+    uint32_t through_letters = 0;
+    uint8_t lm[RACK_SIZE], wm[RACK_SIZE], cr[RACK_SIZE];
+    for (int col = start; ; col++) {
+      if (col < BOARD_DIM && square_get_letter(&sq[col]) != ALPHABET_EMPTY_SQUARE_MARKER) {
+        through_score += gen->tile_scores[square_get_letter(&sq[col])];
+        through_count++;
+        through_letters |= 1U << get_unblanked_machine_letter(square_get_letter(&sq[col]));
+        continue;
+      }
+      // col is empty or off board: the word may end at col - 1.
+      if (k >= 1 && (through_count > 0 || any_cross)) {
+        lb_eval_span(gen, k, through_count, through_letters, through_score, W, cross_const, lm, wm, cr, visit, ctx);
+      }
+      if (col >= BOARD_DIM || k == max_tiles || (blocked_mask >> col) & 1) break;
+      const BonusSquare b = square_get_bonus_square(&sq[col]);
+      lm[k] = bonus_square_get_letter_multiplier(b);
+      wm[k] = bonus_square_get_word_multiplier(b);
+      cr[k] = square_get_is_cross_word(&sq[col]);
+      any_cross |= cr[k];
+      cross_const += square_get_cross_score(&sq[col]) * wm[k];
+      W *= wm[k];
+      k++;
+    }
+  }
+}
+
+static Equity lb_rest(const MoveGen *gen, int k) {
+  Equity eq = (k == RACK_SIZE) ? gen->bingo_bonus : 0;
+  eq += static_eval_get_shadow_equity(&gen->ld, &gen->opponent_rack, gen->best_leaves,
+        gen->full_rack_descending_tile_scores, gen->number_of_tiles_in_bag,
+        rack_get_total_letters(&gen->player_rack), k);
+  return eq;
+}
+
+static bool lb_length_ok(const MoveGen *gen, int k, int through_count) {
+  if (through_count > 0 || k < MINIMUM_WORD_LENGTH || !wmp_move_gen_is_active(&gen->wmp_move_gen)) return true;
+  return wmp_move_gen_nonplaythrough_word_of_length_exists(&gen->wmp_move_gen, k);
+}
+
+typedef struct LBV1Ctx { const MoveGen *gen; Equity best; } LBV1Ctx;
+static void lb_v1_visit(void *vctx, const LBPlacement *pl) {
+  LBV1Ctx *c = vctx;
+  if (!lb_length_ok(c->gen, pl->k, pl->through_count)) return;
+  Equity sc = pl->fixed;
+  for (int i = 0; i < pl->k; i++) sc += c->gen->full_rack_descending_tile_scores[i] * pl->e[i];
+  sc += lb_rest(c->gen, pl->k);
+  if (sc > c->best) c->best = sc;
+}
+
+typedef struct LBEnv {
+  uint16_t e[2][RACK_SIZE + 1][RACK_SIZE];
+  Equity fixed[2][RACK_SIZE + 1];
+  bool any[2][RACK_SIZE + 1];
+} LBEnv;
+static void lb_env_visit(void *vctx, const LBPlacement *pl) {
+  LBEnv *env = vctx;
+  const int t = pl->through_count > 0;
+  if (!env->any[t][pl->k]) { env->any[t][pl->k] = true; env->fixed[t][pl->k] = pl->fixed; }
+  else if (pl->fixed > env->fixed[t][pl->k]) env->fixed[t][pl->k] = pl->fixed;
+  for (int i = 0; i < RACK_SIZE; i++) if (pl->e[i] > env->e[t][pl->k][i]) env->e[t][pl->k][i] = pl->e[i];
+}
+
+static bool lb_rit_ok(const MoveGen *gen, const LBPlacement *pl) {
+  if (gen->rit_entry == NULL || pl->through_count == 0) return true;
+  const int k = pl->k;
+  if (pl->through_count == 1) {
+    if (!rack_info_table_has_playthrough_coverage(gen->rack_info_table, k)) return true;
+    const uint32_t u = rack_info_table_entry_get_playthrough_union(gen->rit_entry, RACK_SIZE - k);
+    return (u & pl->through_letters) != 0;
+  }
+  if (rack_get_letter(&gen->player_rack, BLANK_MACHINE_LETTER) != 0) return true;
+  uint32_t bv = 0;
+  if (!wmp_move_gen_get_multi_pt_bitvec_for_tiles_played(gen->rit_entry, k, k + pl->through_count, &bv)) return true;
+  return (pl->through_letters & ~bv) == 0;
+}
+typedef struct LBV3Ctx { const MoveGen *gen; Equity best; } LBV3Ctx;
+static void lb_v3_visit(void *vctx, const LBPlacement *pl) {
+  LBV3Ctx *c = vctx;
+  if (!lb_length_ok(c->gen, pl->k, pl->through_count)) return;
+  if (!lb_rit_ok(c->gen, pl)) return;
+  Equity sc = pl->fixed;
+  for (int i = 0; i < pl->k; i++) sc += c->gen->full_rack_descending_tile_scores[i] * pl->e[i];
+  sc += lb_rest(c->gen, pl->k);
+  if (sc > c->best) c->best = sc;
+}
+static Equity lane_bound_v3(const MoveGen *gen, const Square *sq) {
+  uint32_t blocked = 0;
+  for (int col = 0; col < BOARD_DIM; col++) {
+    if (square_get_letter(&sq[col]) == ALPHABET_EMPTY_SQUARE_MARKER &&
+        (square_get_cross_set(&sq[col]) & gen->rack_cross_set) == 0) blocked |= 1U << col;
+  }
+  LBV3Ctx c = {gen, EQUITY_MIN_VALUE};
+  lb_enumerate(gen, sq, rack_get_total_letters(&gen->player_rack), blocked, lb_v3_visit, &c);
+  return c.best;
+}
+enum { LB_MAX_GROUPS = 256 };
+typedef struct LBGroup {
+  uint8_t k, through_count;
+  uint32_t through_letters;
+  Equity fixed;
+  uint16_t e[RACK_SIZE];
+} LBGroup;
+typedef struct LBGroups { int n; LBGroup g[LB_MAX_GROUPS]; int overflow; } LBGroups;
+static void lb_groups_visit(void *vctx, const LBPlacement *pl) {
+  LBGroups *gs = vctx;
+  // Groups only need to separate placements the RIT checks can tell apart:
+  // non-through by k; one through tile by (k, letter); several by (k, count, set).
+  const uint8_t tc = (uint8_t)pl->through_count;
+  for (int i = 0; i < gs->n; i++) {
+    LBGroup *g = &gs->g[i];
+    if (g->k == pl->k && g->through_count == tc && g->through_letters == pl->through_letters) {
+      if (pl->fixed > g->fixed) g->fixed = pl->fixed;
+      for (int j = 0; j < RACK_SIZE; j++) if (pl->e[j] > g->e[j]) g->e[j] = pl->e[j];
+      return;
+    }
+  }
+  if (gs->n == LB_MAX_GROUPS) { gs->overflow++; return; }
+  LBGroup *g = &gs->g[gs->n++];
+  g->k = (uint8_t)pl->k; g->through_count = tc; g->through_letters = pl->through_letters;
+  g->fixed = pl->fixed; memcpy(g->e, pl->e, sizeof(g->e));
+}
+static uint64_t lb_groups_total, lb_groups_lanes, lb_groups_overflow;
+static void lane_groups_build(const MoveGen *gen, const Square *sq, LBGroups *gs) {
+  gs->n = 0; gs->overflow = 0;
+  uint32_t blocked = 0;
+  for (int col = 0; col < BOARD_DIM; col++) {
+    if (square_get_letter(&sq[col]) == ALPHABET_EMPTY_SQUARE_MARKER &&
+        (square_get_cross_set(&sq[col]) & ~(uint64_t)1) == 0) blocked |= 1U << col;
+  }
+  lb_enumerate(gen, sq, RACK_SIZE, blocked, lb_groups_visit, gs);
+  lb_groups_total += gs->n; lb_groups_lanes++; lb_groups_overflow += gs->overflow;
+}
+static Equity lane_bound_v5(const MoveGen *gen, const LBGroups *gs) {
+  Equity best = EQUITY_MIN_VALUE;
+  const int n = rack_get_total_letters(&gen->player_rack);
+  for (int i = 0; i < gs->n; i++) {
+    const LBGroup *g = &gs->g[i];
+    if (g->k > n) continue;
+    LBPlacement pl; pl.k = g->k; pl.through_count = g->through_count; pl.through_letters = g->through_letters;
+    if (!lb_length_ok(gen, g->k, g->through_count)) continue;
+    if (!lb_rit_ok(gen, &pl)) continue;
+    Equity sc = g->fixed;
+    for (int j = 0; j < g->k; j++) sc += gen->full_rack_descending_tile_scores[j] * g->e[j];
+    sc += lb_rest(gen, g->k);
+    if (sc > best) best = sc;
+  }
+  return best;
+}
+static Equity lane_bound_v1(const MoveGen *gen, const Square *sq) {
+  uint32_t blocked = 0;
+  for (int col = 0; col < BOARD_DIM; col++) {
+    if (square_get_letter(&sq[col]) == ALPHABET_EMPTY_SQUARE_MARKER &&
+        (square_get_cross_set(&sq[col]) & gen->rack_cross_set) == 0) blocked |= 1U << col;
+  }
+  LBV1Ctx c = {gen, EQUITY_MIN_VALUE};
+  lb_enumerate(gen, sq, rack_get_total_letters(&gen->player_rack), blocked, lb_v1_visit, &c);
+  return c.best;
+}
+
+static void lane_env_build(const MoveGen *gen, const Square *sq, LBEnv *env) {
+  memset(env, 0, sizeof(*env));
+  uint32_t blocked = 0;
+  for (int col = 0; col < BOARD_DIM; col++) {
+    if (square_get_letter(&sq[col]) == ALPHABET_EMPTY_SQUARE_MARKER &&
+        (square_get_cross_set(&sq[col]) & ~(uint64_t)1) == 0) blocked |= 1U << col;
+  }
+  lb_enumerate(gen, sq, RACK_SIZE, blocked, lb_env_visit, env);
+}
+
+static Equity lane_bound_v2(const MoveGen *gen, const LBEnv *env) {
+  Equity best = EQUITY_MIN_VALUE;
+  const int n = rack_get_total_letters(&gen->player_rack);
+  for (int t = 0; t < 2; t++) for (int k = 1; k <= n; k++) {
+    if (!env->any[t][k]) continue;
+    if (t == 0 && !lb_length_ok(gen, k, 0)) continue;
+    Equity sc = env->fixed[t][k];
+    for (int i = 0; i < k; i++) sc += gen->full_rack_descending_tile_scores[i] * env->e[t][k][i];
+    sc += lb_rest(gen, k);
+    if (sc > best) best = sc;
+  }
+  return best;
+}
+
+static uint64_t lb_skip_ticks[4], lb_skip_unexp_ticks[4], lb_violations[4], lb_v5_combine_ticks, lb_cost_ticks[3], lb_measured_gens, lb_best_lanes;
+static uint64_t lb_lanes_skipped[4], lb_lanes_total;
+
