+// Oracle experiment: ORACLE=record:<file> writes one bit per expanded WMP
+// anchor (1 = some placement passed); ORACLE=skipall|skippt|skipnonpt:<file>
+// replays the same games and skips the unproductive anchors of that kind.
+static int oracle_mode = -1; // 0 none, 1 record, 2 skip all, 3 skip pt, 4 skip nonpt
+static FILE *oracle_file;
+static uint8_t oracle_byte;
+static int oracle_bit;
+uint64_t oracle_pass_counter;
+static uint64_t oracle_skipped, oracle_seen;
+static FILE *dump_file;
+static void __attribute__((destructor)) oracle_close(void) {
+  if (dump_file) fclose(dump_file);
+  if (oracle_mode == 1 && oracle_bit > 0) fputc(oracle_byte, oracle_file);
+  if (oracle_file) fclose(oracle_file);
+  if (oracle_mode > 0) fprintf(stderr, "ORACLE anchors %llu skipped %llu\n", (unsigned long long)oracle_seen, (unsigned long long)oracle_skipped);
+}
+static void oracle_init(void) {
+  const char *env = getenv("ORACLE");
+  oracle_mode = 0;
+  if (env == NULL) return;
+  const char *colon = strchr(env, ':');
+  if (colon == NULL) return;
+  if (strncmp(env, "record", 6) == 0) oracle_mode = 1;
+  else if (strncmp(env, "skipall", 7) == 0) oracle_mode = 2;
+  else if (strncmp(env, "skipnonpt", 9) == 0) oracle_mode = 4;
+  else if (strncmp(env, "skippt", 6) == 0) oracle_mode = 3;
+  oracle_file = fopen(colon + 1, oracle_mode == 1 ? "wb" : "rb");
+  if (oracle_file == NULL) { fprintf(stderr, "oracle: cannot open %s\n", colon + 1); exit(1); }
+}
+static inline int oracle_read_bit(void) {
+  if (oracle_bit == 0) { int c = fgetc(oracle_file); oracle_byte = (uint8_t)(c == EOF ? 0xFF : c); }
+  const int b = (oracle_byte >> oracle_bit) & 1;
+  oracle_bit = (oracle_bit + 1) & 7;
+  return b;
+}
