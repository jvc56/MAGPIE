+enum { SR_BITS = 25 };
+static int sr_insert(uint64_t *set, uint64_t key) { // returns 1 if already present
+  if (key == 0) key = 1;
+  uint64_t i = (key * 0x9E3779B97F4A7C15ULL) >> (64 - SR_BITS);
+  for (;;) {
+    if (set[i] == key) return 1;
+    if (set[i] == 0) { set[i] = key; return 0; }
+    i = (i + 1) & ((1ULL << SR_BITS) - 1);
+  }
+}
