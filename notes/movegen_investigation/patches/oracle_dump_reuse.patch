+static uint64_t ar_window_key(const MoveGen *gen, int col, int *width) {
+  const int n = gen->number_of_letters_on_rack > 0 ? gen->number_of_letters_on_rack : rack_get_total_letters(&gen->player_rack);
+  int lo_bound = gen->last_anchor_col == INITIAL_LAST_ANCHOR_COL ? 0 : gen->last_anchor_col + 1;
+  if (lo_bound < 0) lo_bound = 0;
+  int lo = col, empties = 0;
+  while (lo - 1 >= lo_bound) { if (gen_cache_is_empty(gen, lo - 1)) { if (empties == n) break; empties++; } lo--; }
+  int hi = col; empties = gen_cache_is_empty(gen, col) ? 1 : 0;
+  while (hi + 1 < BOARD_DIM) { if (gen_cache_is_empty(gen, hi + 1)) { if (empties == n) break; empties++; } hi++; }
+  if (lo > 0) lo--;
+  if (hi < BOARD_DIM - 1) hi++;
+  *width = hi - lo + 1;
+  uint64_t h = 0x9E3779B97F4A7C15ULL ^ ((uint64_t)lo << 8) ^ ((uint64_t)hi << 16) ^ ((uint64_t)col << 24) ^ ((uint64_t)gen->dir << 32) ^ ((uint64_t)(gen->last_anchor_col + 2) << 40);
+  for (int c = lo; c <= hi; c++) {
+    const Square *sq = &gen->row_squares[c];
+    const uint64_t w1 = (uint64_t)(uint32_t)square_get_cross_score(sq) | ((uint64_t)square_get_letter(sq) << 32) | ((uint64_t)square_get_bonus_square(sq).raw << 40) | ((uint64_t)square_get_anchor(sq) << 48) | ((uint64_t)square_get_is_cross_word(sq) << 49);
+    h = (h ^ w1) * 0xFF51AFD7ED558CCDULL; h ^= h >> 29;
+    h = (h ^ square_get_cross_set(sq)) * 0xC4CEB9FE1A85EC53ULL; h ^= h >> 31;
+    h = (h ^ gen_cache_get_left_extension_set(gen, c)) * 0xFF51AFD7ED558CCDULL; h ^= h >> 29;
+    h = (h ^ gen_cache_get_right_extension_set(gen, c)) * 0xC4CEB9FE1A85EC53ULL; h ^= h >> 31;
+  }
+  return h | 1;
+}
